# Copy to .env and fill in your Contentstack stack credentials.
# Public (sent to the browser for the live-preview SDK):
NEXT_PUBLIC_CS_API_KEY=your_stack_api_key
NEXT_PUBLIC_CS_PREVIEW_TOKEN=your_preview_token
NEXT_PUBLIC_CS_ENVIRONMENT=development
NEXT_PUBLIC_CS_PREVIEW_HOST=rest-preview.contentstack.com
NEXT_PUBLIC_CS_APP_HOST=app.contentstack.com
NEXT_PUBLIC_CS_LOCALE=en-us
# Server-only (never sent to the browser):
CS_DELIVERY_TOKEN=your_delivery_token
CS_CDN_HOST=cdn.contentstack.io
