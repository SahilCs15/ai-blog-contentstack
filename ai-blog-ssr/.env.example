# SSR AI-blog app — MULTI-REGION. One build serves every region; the active
# region comes from the `/{region}/{locale}/...` path. src/lib/regions.ts only
# lists region ids — EVERY environment-specific value lives here in env.
#
# Values are read SERVER-SIDE (getRegionConfig), so they are plain server-only
# vars (no NEXT_PUBLIC needed); the client LivePreviewInit gets the public subset
# as props. Per region (<REGION> = id upper-cased, non-alphanumerics → '_'):
#   CS_API_KEY_<REGION>       CS_ENVIRONMENT_<REGION>   (env optional, default 'development')
#   CS_CDN_HOST_<REGION>      CS_PREVIEW_HOST_<REGION>  CS_APP_HOST_<REGION>
#   CS_DELIVERY_TOKEN_<REGION>   CS_PREVIEW_TOKEN_<REGION>

NEXT_PUBLIC_CS_DEFAULT_REGION=dev11
NEXT_PUBLIC_CS_LOCALE=en-us

# --- example: dev11 ---
CS_API_KEY_DEV11=your_stack_api_key
CS_ENVIRONMENT_DEV11=development
CS_CDN_HOST_DEV11=dev11-cdn.csnonprod.com
CS_PREVIEW_HOST_DEV11=dev11-rest-preview.csnonprod.com
CS_APP_HOST_DEV11=dev11-app.csnonprod.com
CS_DELIVERY_TOKEN_DEV11=your_delivery_token
CS_PREVIEW_TOKEN_DEV11=your_preview_token

# Repeat the 7 vars for each region id in src/lib/regions.ts:
# dev23, aws-stag, azure-na-stag, gcp-na-stag, aws-na, aws-eu, aws-au,
# azure-na, azure-eu, gcp-na, gcp-eu
