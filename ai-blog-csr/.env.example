# Copy to .env and fill in your Contentstack stack credentials.
# Vite exposes only VITE_*-prefixed vars to the browser (a CSR app needs them client-side).
VITE_CS_API_KEY=your_stack_api_key
VITE_CS_DELIVERY_TOKEN=your_delivery_token
VITE_CS_PREVIEW_TOKEN=your_preview_token
VITE_CS_ENVIRONMENT=development
VITE_CS_CDN_HOST=cdn.contentstack.io
VITE_CS_PREVIEW_HOST=rest-preview.contentstack.com
VITE_CS_APP_HOST=app.contentstack.com
VITE_CS_LOCALE=en-us
