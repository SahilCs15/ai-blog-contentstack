# CSR AI-blog app — MULTI-REGION. One build serves every region; the active
# region comes from the `/{region}/{locale}/...` path. src/lib/regions.ts only
# lists region ids — EVERY environment-specific value lives here in env.
#
# Per region (<REGION> = id upper-cased, non-alphanumerics → '_', e.g. aws-na → AWS_NA):
#   VITE_CS_API_KEY_<REGION>
#   VITE_CS_ENVIRONMENT_<REGION>     (optional; defaults to 'development')
#   VITE_CS_CDN_HOST_<REGION>
#   VITE_CS_PREVIEW_HOST_<REGION>
#   VITE_CS_APP_HOST_<REGION>
#   VITE_CS_DELIVERY_TOKEN_<REGION>
#   VITE_CS_PREVIEW_TOKEN_<REGION>

VITE_CS_DEFAULT_REGION=dev11
VITE_CS_LOCALE=en-us

# --- example: dev11 ---
VITE_CS_API_KEY_DEV11=your_stack_api_key
VITE_CS_ENVIRONMENT_DEV11=development
VITE_CS_CDN_HOST_DEV11=dev11-cdn.csnonprod.com
VITE_CS_PREVIEW_HOST_DEV11=dev11-rest-preview.csnonprod.com
VITE_CS_APP_HOST_DEV11=dev11-app.csnonprod.com
VITE_CS_DELIVERY_TOKEN_DEV11=your_delivery_token
VITE_CS_PREVIEW_TOKEN_DEV11=your_preview_token

# Repeat the 7 vars for each region id in src/lib/regions.ts:
# dev23, aws-stag, azure-na-stag, gcp-na-stag, aws-na, aws-eu, aws-au,
# azure-na, azure-eu, gcp-na, gcp-eu
